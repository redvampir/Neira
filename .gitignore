# NEI-20251105: Обновлён .gitignore для безопасной публикации на GitHub

# Compiler sources (moved to separate repo)
binutils-gdb/
llvm-project/
cargo/
rust/
nasm/

# Dependencies
node_modules/
sensory_organs/node_modules/
target/
venv/
*/venv/
**/*venv/

# Environment и секреты
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# Логи
logs/*
!logs/.keep
!logs/events.ndjson

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Git
**/.git*
!.gitmodules
!/.github/
!/.github/workflows/
!/.github/workflows/**

