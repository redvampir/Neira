# Environment Configuration Example for Neira

# Backend
PORT=9090
HOST=0.0.0.0

# CORS (для cross-origin запросов)
# Разделяй запятыми, без пробелов
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# API версия
API_VERSION=1.0.0

# WebSocket events
WEBSOCKET_EVENTS_ENABLED=true

# Homeostasis (автономная регуляция ресурсов)
HOMEOSTASIS_CHECK_INTERVAL_SECS=10
HOMEOSTASIS_BACKPRESSURE_THRESHOLD=0.7

# Режим работы агента (explore|perform|safe-mode)
NEIRA_AUTONOMY_MODE=perform

# Логирование
RUST_LOG=info,backend=debug

# Feature Gates (включение/выключение возможностей)
ORGANS_BUILDER_ENABLED=true
FACTORY_ADAPTER_ENABLED=true

# Voice (голосовые возможности)
# Если не настроено, будет использован режим stub
VOICE_BACKEND_MODE=stub

# Context (контекстная память)
CONTEXT_DIR=./context

# Training (обучение)
# Путь к данным для обучения
TRAINING_DATA_DIR=./data/training

# Digestive Pipeline (парсинг входных данных)
DIGESTIVE_CONFIG=./spinal_cord/config/digestive.toml
